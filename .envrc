# direnv: `direnv allow` once (without direnv: `source ./activate`).
# See common/env.sh for what gets set.
watch_file .node-version common/env.sh uv.lock tools/state.json .env
source_env common/env.sh

# Component selection and tokens (.env, see .env.example) and personal
# overrides (.envrc.local) stay out of git.
dotenv_if_exists .env
source_env_if_exists .envrc.local
