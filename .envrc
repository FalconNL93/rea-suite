# direnv: `direnv allow` once (without direnv: `source ./activate`).
# See common/env.sh for what gets set.
watch_file .node-version common/env.sh uv.lock tools/state.json
source_env common/env.sh

# Personal overrides (tokens, alternate JAVA_HOME, ...) stay out of git.
source_env_if_exists .envrc.local
