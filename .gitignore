# --- Local runtimes and downloads (platforms/*/bootstrap, rea-tools) ---
/.runtime/
/tools/

# --- Dependencies ---
node_modules/
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/
.gradle/
*.egg-info/
/dist/
/build/

# --- Analysis work: targets, captures and databases never go into git ---
/work/*
!/work/.gitkeep
*.gpr
*.rep/
*.lock~
*.pcap
*.pcapng
*.har
*.flows
*.idb
*.i64
*.id0
*.id1
*.id2
*.nam
*.til
*.rzdb
*.bndb
*.gzf
*.dmp
*.core
core
core.[0-9]*
.gdb_history
*.log

# --- Safety net: samples belong in work/, never in git ---
*.exe
*.dll
*.sys
*.so
*.so.*
*.dylib
*.apk
*.aab
*.ipa
*.dex
*.xex
*.elf
*.msi
*.zip
*.7z
*.rar
*.jar

# --- Local config / secrets ---
.envrc.local
.env
.env.*
!.env.example
*.pem
*.key
.direnv/
.claude/settings.local.json

# --- Editors / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
