#!/usr/bin/env bash
# rea-suite: set up, update and repair the whole suite (Debian/Ubuntu/WSL).
#
#   rea-suite setup   [--no-apt] [--angr]   first install / repair; safe to re-run
#   rea-suite update  [--no-apt] [--angr]   update everything: apt packages, Detect It Easy,
#                                            Python (uv.lock), rea-agents, tools.yml tools,
#                                            REA skill
#   rea-suite reinstall <what...>           python | node | tools | system | all | <tool>
#                                            (<tool> = a name from common/tools.yml)
#   rea-suite status                        versions of everything + `rea doctor` summary
#   rea-suite agents [client...]            register the rea MCP server (via bin/rea) and
#                                            install/refresh the REA skill; default claude_code
#   rea-suite tools <args...>               tools.yml manager (= rea-tools)
#
#   --no-apt  skip apt and Detect It Easy (no sudo)
#   --angr    include angr; kept automatically once installed
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
cd "$ROOT"
export REA_SUITE_ROOT="$ROOT"
# shellcheck source=common/env.sh disable=SC1091
source common/env.sh

APT_LIST=platforms/linux/apt-packages.txt
NODE_VERSION="$(tr -d '[:space:]' <.node-version)"

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null || { echo "missing: $1 (install: $2)" >&2; exit 1; }; }
usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }

# --- components --------------------------------------------------------------

apt_packages() { # [--reinstall]
  step "apt packages"
  local pkgs
  mapfile -t pkgs < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$APT_LIST")
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" "${pkgs[@]}"
}

detect_it_easy() { # [--reinstall]
  # Official distro .deb (not in the Ubuntu archive); apt resolves its Qt5 deps.
  step "Detect It Easy"
  local tag url tmp ID VERSION_ID
  # shellcheck source=/dev/null
  . /etc/os-release
  read -r tag url < <(rea-tools asset horsicq/DIE-engine \
    "^die_[\\d.]+_${ID^}_${VERSION_ID}_amd64\\.deb\$")
  if [[ "${1:-}" != --reinstall &&
    "$(dpkg-query -W -f='${Version}' detectiteasy 2>/dev/null)" == "$tag" ]]; then
    echo "detectiteasy $tag is up to date"
    return
  fi
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/detectiteasy_${tag}_amd64.deb" "$url"
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "$@" "$tmp/detectiteasy_${tag}_amd64.deb"
  rm -rf "$tmp"
}

python_env() { # [--upgrade]
  step "Python (uv)"
  need uv "curl -LsSf https://astral.sh/uv/install.sh | sh"
  local args=()
  ((ANGR == 0)) || args+=(--group angr)
  [[ "${1:-}" != --upgrade ]] || uv lock --upgrade
  uv sync "${args[@]}"
}

node_env() { # [--upgrade]
  step "Node $NODE_VERSION + rea-agents (fnm/npm)"
  need fnm "curl -fsSL https://fnm.vercel.app/install | bash"
  fnm install "$NODE_VERSION"
  if [[ "${1:-}" == --upgrade ]]; then
    # rea moves fast and bumps majors; follow latest, the lockfile records it
    fnm exec --using="$NODE_VERSION" -- npm install rea-agents@latest
  else
    fnm exec --using="$NODE_VERSION" -- npm ci
  fi
}

suite_tools() { # install | update
  step "tools from common/tools.yml"
  # re-source so freshly synced .venv/bin and node are on PATH
  # shellcheck source=common/env.sh disable=SC1091
  source common/env.sh
  rea-tools "$1"
}

rea_skill() { # [client...]
  local client
  for client in "${@:-claude_code}"; do
    step "REA skill for $client"
    "$ROOT/bin/rea" setup --yes --skill-client "$client"
  done
}

check_java() {
  java -version 2>&1 | grep -qE 'version "(2[1-9]|[3-9][0-9])' ||
    warn "no JDK 21+ on PATH; Ghidra, JADX and apktool need one (apt install openjdk-21-jdk)"
}

# --- commands ----------------------------------------------------------------

cmd_setup() {
  ((APT == 0)) || apt_packages
  python_env
  node_env
  suite_tools install
  ((APT == 0)) || detect_it_easy
  check_java
  step "done"
  echo "Next: 'direnv allow' in $ROOT, then 'rea-suite agents' to register REA with your agent."
}

cmd_update() {
  ((APT == 0)) || apt_packages
  python_env --upgrade
  node_env --upgrade
  suite_tools update
  ((APT == 0)) || detect_it_easy
  if [ -d "$HOME/.claude/skills/reverse-engineer-anything" ]; then
    rea_skill claude_code
  fi
  check_java
  step "done"
  git -C "$ROOT" status --short -- uv.lock package.json package-lock.json
  echo "Commit the lockfile changes above to record the new versions."
}

cmd_reinstall() {
  (($#)) || { echo "reinstall what? python | node | tools | system | all | <tool>" >&2; exit 2; }
  local what
  for what in "$@"; do
    case "$what" in
      python) rm -rf .venv && python_env ;;
      node) rm -rf node_modules && node_env ;;
      tools) rea-tools reinstall ;;
      system)
        if ((APT)); then apt_packages --reinstall && detect_it_easy --reinstall; fi
        ;;
      all) cmd_reinstall system python node tools ;;
      *) rea-tools reinstall "$what" ;;
    esac
  done
}

cmd_status() {
  step "runtimes"
  printf '%-13s %s\n' node "$(node --version 2>/dev/null || echo -)" \
    python "$(.venv/bin/python --version 2>/dev/null || echo -)" \
    java "$(java -version 2>&1 | head -1)" \
    rea-agents "$(node -p 'require("./node_modules/rea-agents/package.json").version' 2>/dev/null || echo -)" \
    "  (latest)" "$(npm view rea-agents version 2>/dev/null || echo '?')" \
    detectiteasy "$(dpkg-query -W -f='${Version}' detectiteasy 2>/dev/null || echo -)"
  step "Python packages (direct; newer releases are marked)"
  uv tree --outdated --depth 1 2>/dev/null | tail -n +2 || true
  step "tools.yml"
  rea-tools status
  step "rea doctor (failing checks)"
  { "$ROOT/bin/rea" doctor --format json 2>/dev/null || true; } | python3 -c '
import json, sys
seen = set()
def walk(o):
    if isinstance(o, dict):
        if o.get("ok") is False and o.get("name") not in seen:
            seen.add(o.get("name"))
            print(f"  {o.get("name")}: {o.get("remediation") or o.get("detail")}")
        for v in o.values(): walk(v)
    elif isinstance(o, list):
        for v in o: walk(v)
walk(json.load(sys.stdin))
print("  (none)" if not seen else "", end="")' || warn "rea doctor failed"
}

cmd_agents() {
  local clients=("${@:-claude_code}") client
  for client in "${clients[@]}"; do
    if [[ "$client" == claude_code ]]; then
      need claude "https://claude.com/claude-code"
      step "MCP registration for Claude Code"
      claude mcp remove --scope user rea >/dev/null 2>&1 || true
      claude mcp add --scope user rea -- "$ROOT/bin/rea" mcp
    else
      warn "$client: register '$ROOT/bin/rea mcp' as MCP server manually (rea setup would bypass bin/rea)"
    fi
  done
  rea_skill "${clients[@]}"
}

# --- main --------------------------------------------------------------------

APT=1
# keep angr once it has been installed
ANGR=0
compgen -G ".venv/lib/python*/site-packages/angr" >/dev/null && ANGR=1
cmd="${1:-}"
(($#)) && shift
args=()
for arg in "$@"; do
  case "$arg" in
    --no-apt) APT=0 ;;
    --angr) ANGR=1 ;;
    *) args+=("$arg") ;;
  esac
done

case "$cmd" in
  setup) cmd_setup ;;
  update) cmd_update ;;
  reinstall) cmd_reinstall "${args[@]}" ;;
  status) cmd_status ;;
  agents) cmd_agents "${args[@]}" ;;
  tools) rea-tools "${args[@]}" ;;
  -h | --help | help | "") usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
