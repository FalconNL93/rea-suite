#!/usr/bin/env bash
# rea-suite: set up, update and repair the whole suite (Debian/Ubuntu/WSL, Fedora/RHEL, Arch, macOS).
#
#   rea-suite setup   [--no-apt|--no-brew]  install / repair; safe to re-run (runtimes in
#                                            .runtime/ come from platforms/<os>/bootstrap.sh)
#   rea-suite select                        choose optional components (common/components.yml);
#                                            stored in .env, then run setup
#   rea-suite update  [--no-apt|--no-brew]  update everything: runtimes, apt/brew packages,
#                                            Python (uv.lock), rea-agents, tools.yml tools,
#                                            REA skill (every detected agent)
#   rea-suite update --ai                   an agent (the first CLI found, or REA_SUITE_AGENT) checks
#                                            compatibility first, proposes what to update to
#                                            which version and what to hold, then applies it
#                                            once you agree
#   rea-suite reinstall <what...>           runtime | python | node | tools | system | all |
#                                            <tool> (= a name from common/tools.yml)
#   rea-suite doctor                        check the installation; exit 1 on problems
#   rea-suite status                        versions + available updates
#   rea-suite agents [client...]            register (or repair) the rea MCP server via
#                                            bin/rea and install/refresh the REA skill;
#                                            default: every agent rea-agents detects
#   rea-suite analyze [paths...] [options]  offline analysis projects; --examples for workflows
#   rea-suite tools <args...>               tools.yml manager (= rea-tools)
#   rea-suite lint [file...]                ruff, shellcheck and a PowerShell parse check on
#                                            this repository (.githooks/lint.sh)
#   rea-suite clean [caches|builds|tools|all]  free disk space: download caches (uv, npm,
#                                            NuGet, Gradle), source builds (.runtime/build)
#                                            and inactive tool versions; without an
#                                            argument only shows the sizes
#
#   --no-apt/--no-dnf/--no-pacman  skip system packages (no sudo); --no-brew  skip Homebrew (macOS)
set -euo pipefail

# macOS: Homebrew's bash (platforms/macos/Brewfile), not the bundled 3.2
((BASH_VERSINFO[0] >= 4)) || exec /opt/homebrew/bin/bash "$0" "$@"

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
CALLER_CWD="$PWD"
cd "$ROOT"
export REA_SUITE_ROOT="$ROOT"
# shellcheck source=common/box.sh disable=SC1091
source "$REA_SUITE_ROOT/common/box.sh" # immutable host: on inside the distrobox
# shellcheck source=common/env.sh disable=SC1091
source common/env.sh

case "$(uname -s)" in
  Darwin) OS=macos ;;
  *)
    OS=linux
    # shellcheck source=platforms/linux/packages.sh disable=SC1091
    source platforms/linux/packages.sh
    ;;
esac
APT_LIST=platforms/linux/apt-packages.txt
BREWFILE=platforms/macos/Brewfile
NODE_VERSION="$(tr -d '[:space:]' <.node-version)"

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
need() { command -v "$1" >/dev/null || { echo "missing: $1 (run $2)" >&2; exit 1; }; }
BOOTSTRAP=platforms/$OS/bootstrap.sh
components() { uv run --quiet common/rea_suite/components.py "$@"; }
agents() { uv run --quiet common/rea_suite/agents.py "$@"; }
usage() { sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; }

# --- components --------------------------------------------------------------

system_packages() { # [--reinstall | --upgrade]
  if [[ "$OS" == macos ]]; then brew_packages "$@"
  elif [[ "${1:-}" == --reinstall ]]; then linux_packages --reinstall
  else linux_packages; fi
}

# the base list plus the selected components', in this system's names (packages.sh)
linux_package_names() {
  { sed -e 's/#.*//' -e '/^[[:space:]]*$/d' "$APT_LIST"; components packages apt; } | pkg_native
}

linux_packages() { # [--reinstall]
  step "system packages ($(pkg_manager))"
  local pkgs
  mapfile -t pkgs < <(linux_package_names)
  pkg_install "$@" "${pkgs[@]}"
}

brewfile() { # base Brewfile plus the selected components' packages
  cat "$BREWFILE"
  components packages brew
}

brew_packages() { # [--reinstall | --upgrade]
  step "Homebrew packages"
  need brew "https://brew.sh"
  case "${1:-}" in
    --reinstall)
      brewfile | brew bundle install --file=- --no-upgrade
      local formulae casks
      read -ra formulae <<<"$(brewfile | brew bundle list --file=- --formula | xargs)"
      read -ra casks <<<"$(brewfile | brew bundle list --file=- --cask | xargs)"
      ((${#formulae[@]} == 0)) || brew reinstall "${formulae[@]}"
      ((${#casks[@]} == 0)) || brew reinstall --cask "${casks[@]}"
      ;;
    --upgrade) brewfile | brew bundle install --file=- --upgrade ;;
    *) brewfile | brew bundle install --file=- --no-upgrade ;;
  esac
}

python_env() { # [--upgrade]
  step "Python (uv)"
  need uv "$BOOTSTRAP"
  local args
  read -ra args <<<"$(components uv-args)"
  [[ "${1:-}" != --upgrade ]] || uv lock --upgrade
  uv sync "${args[@]}"
}

uv_tools() { # [--upgrade]
  step "isolated CLI tools (common/uv-tools.txt)"
  local line spec platform
  while read -r line; do
    spec="${line%% @*}"
    platform="${line##* @}"
    [[ "$line" != *" @"* || "$platform" == "$OS" ]] || continue
    if [[ "${1:-}" == --upgrade ]]; then
      uv tool install --upgrade "$spec"
    else
      uv tool install "$spec"
    fi
  done < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]*$//' common/uv-tools.txt)
}

rea_agents_version() {
  node -p 'require("./node_modules/rea-agents/package.json").version' 2>/dev/null || echo none
}

node_env() { # [--upgrade]
  step "Node $NODE_VERSION + rea-agents (fnm/npm)"
  need fnm "$BOOTSTRAP"
  fnm install "$NODE_VERSION" 2>&1 | grep -v '^warning: Version already installed' || true
  if [[ "${1:-}" == --upgrade ]]; then
    # rea moves fast and bumps majors; follow latest, the lockfile records it
    local before after
    before="$(rea_agents_version)"
    fnm exec --using="$NODE_VERSION" -- npm install rea-agents@latest
    fnm exec --using="$NODE_VERSION" -- npm update # the other tools in package.json
    after="$(rea_agents_version)"
    [[ "$before" == "$after" ]] || echo "rea-agents $before -> $after"
  else
    fnm exec --using="$NODE_VERSION" -- npm ci
  fi
  browsers
}

# Browsers of the selected components (component `browser`), from rea-agents' own
# playwright-core: it downloads only a build it does not have yet and drops old ones.
browsers() {
  local browser
  local system=""
  for browser in $(components values playwright); do
    step "$browser for REA (Playwright, .runtime/ms-playwright)"
    fnm exec --using="$NODE_VERSION" -- node node_modules/playwright-core/cli.js install "$browser" && continue
    # Playwright publishes builds for the distributions it supports (not Ubuntu 26.04 yet): a system Chrome or
    # Chromium serves REA instead, rather than setup failing on it.
    [ "$browser" = chromium ] || { warn "$browser: Playwright has no build for this system"; continue; }
    local candidate
    for candidate in google-chrome chromium chromium-browser google-chrome-stable; do
      system="$(command -v "$candidate" || true)"
      [ -z "$system" ] || break
    done
    if [ -n "$system" ]; then
      warn "chromium: Playwright has no build for this system; REA uses $system"
    else
      warn "chromium: Playwright has no build for this system and none is installed (apt: chromium); REA's browser tools stay off"
    fi
  done
  if [ -n "$system" ]; then
    printf '%s\n' "$system" >"$REA_RUNTIME/chromium-path"
    return
  fi
  # REA_BROWSER_EXECUTABLE (common/env.sh) reads this
  fnm exec --using="$NODE_VERSION" -- node -e '
    import("playwright-core").then(({ chromium }) => {
      const fs = require("fs"), path = chromium.executablePath();
      if (fs.existsSync(path)) fs.writeFileSync(process.argv[1], path + "\n");
    })' "$REA_RUNTIME/chromium-path"
}

suite_tools() { # install | update
  step "tools from common/tools.yml"
  # re-source so freshly synced .venv/bin and node are on PATH
  # shellcheck source=common/env.sh disable=SC1091
  source common/env.sh
  rea-tools "$1"
}

runtimes() { # [--update]
  local flags=(--runtimes-only "$@")
  if ((SYSTEM == 0)); then
    if [[ "$OS" == macos ]]; then flags+=(--no-brew); else flags+=(--no-apt); fi
  fi
  "$ROOT/$BOOTSTRAP" "${flags[@]}"
  # shellcheck source=common/env.sh disable=SC1091
  source common/env.sh
}

# --- commands ----------------------------------------------------------------

git_hooks() {
  # gitleaks pre-commit/pre-push hooks (.githooks); harmless outside a git checkout
  if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    git -C "$ROOT" config core.hooksPath .githooks
  fi
}

cmd_setup() {
  components adopt
  ((SYSTEM == 0)) || system_packages
  python_env
  uv_tools
  node_env
  suite_tools install
  git_hooks
  step "bin/ on your PATH (shell startup file; REA_SUITE_NO_PATH=1 skips)"
  uv run --quiet common/rea_suite/userpath.py add
  step "done"
  echo "Next: 'direnv allow' (or 'source ./activate'), 'rea-suite doctor', and"
  echo "'rea-suite agents' to register REA with your agent."
}

cmd_update() {
  components adopt
  runtimes --update
  ((SYSTEM == 0)) || system_packages --upgrade
  python_env --upgrade
  uv_tools --upgrade
  node_env --upgrade
  suite_tools update
  step "versions REA verifies (Ghidra pin, JDK)"
  rea-tools rea-pins || warn "the new rea-agents verifies other versions; follow the hints above"
  agents skills
  step "done"
  git -C "$ROOT" status --short -- uv.lock package.json package-lock.json
  echo "Commit the lockfile changes above to record the new versions."
}

cmd_reinstall() {
  (($#)) || { echo "reinstall what? runtime | python | node | tools | system | all | <tool>" >&2; exit 2; }
  local what
  for what in "$@"; do
    case "$what" in
      runtime) rm -rf .runtime && runtimes ;;
      python) rm -rf .venv .runtime/uv-tools && python_env && uv_tools ;;
      node) rm -rf node_modules && node_env ;;
      tools) rea-tools reinstall ;;
      system)
        if ((SYSTEM)); then system_packages --reinstall; fi
        ;;
      all) cmd_reinstall system runtime python node tools ;;
      *) rea-tools reinstall "$what" ;;
    esac
  done
}

CACHES=(uv npm nuget gradle) # in .runtime/cache (common/env.sh)

cmd_clean() {
  local what name dir
  if (($# == 0)); then
    step "caches (rea-suite clean caches); refilled on the next setup or build"
    for name in "${CACHES[@]}"; do
      dir="$REA_RUNTIME/cache/$name"
      [[ ! -d "$dir" ]] || printf '  %-8s %6s  %s\n' "$name" "$(du -sh "$dir" | cut -f1)" "$dir"
    done
    dir="$CARGO_HOME/registry"
    [[ ! -d "$dir" ]] || printf '  %-8s %6s  %s\n' cargo "$(du -sh "$dir" | cut -f1)" "$dir"
    step "sources and build trees (rea-suite clean builds); the next build starts afresh"
    [[ ! -d "$REA_RUNTIME/build" ]] || du -sh "$REA_RUNTIME/build"/* 2>/dev/null | sed 's/^/  /'
    step "inactive tool versions (rea-suite clean tools); 'rea-tools use' rolls back to them"
    rea-tools prune --dry-run
    return
  fi
  [[ " $* " != *" all "* ]] || set -- caches builds tools
  for what in "$@"; do
    case "$what" in
      caches)
        step "clean caches"
        uv cache clean
        dotnet nuget locals all --clear
        # npm's own clean leaves _prebuilds (frida); Gradle has no clean command;
        # cargo's downloaded crates are refetched by the next build
        rm -rf "$REA_RUNTIME/cache/npm" "$REA_RUNTIME/cache/gradle" "$REA_RUNTIME/cache/dotnet-install.sh" \
          "$CARGO_HOME/registry" "$CARGO_HOME/git"
        ;;
      builds) step "clean builds"; rm -rf "$REA_RUNTIME/build" ;;
      tools) step "clean tools"; rea-tools prune ;;
      *) echo "clean what? caches | builds | tools | all" >&2; exit 2 ;;
    esac
  done
}

cmd_status() {
  step "runtimes"
  printf '%-13s %s\n' node "$(node --version 2>/dev/null || echo -)" \
    python "$(.venv/bin/python --version 2>/dev/null || echo -)" \
    java "$(java -version 2>&1 | head -1)" \
    rea-agents "$(node -p 'require("./node_modules/rea-agents/package.json").version' 2>/dev/null || echo -)" \
    "  (latest)" "$(npm view rea-agents version 2>/dev/null || echo '?')" \
    dotnet "$(dotnet --version 2>/dev/null || echo -)" \
    uv "$(uv --version 2>/dev/null || echo -)"
  step "Python packages (direct; newer releases are marked)"
  uv tree --outdated --depth 1 2>/dev/null | tail -n +2 || true
  step "isolated uv tools (common/uv-tools.txt)"
  uv tool list --outdated 2>/dev/null || true
  step "npm packages (package.json; none listed = up to date)"
  npm outdated 2>/dev/null || true
  step "tools.yml"
  rea-tools status
  step "system packages of the suite with updates"
  local pkgs
  if [[ "$OS" == macos ]]; then
    mapfile -t pkgs < <(brewfile | sed -n 's/^\(brew\|cask\) "\([^"]*\)".*/\2/p')
    HOMEBREW_NO_AUTO_UPDATE=1 brew outdated --verbose "${pkgs[@]}" 2>/dev/null || true
  else
    mapfile -t pkgs < <(linux_package_names)
    pkg_upgradable "${pkgs[@]}"
  fi
  rea_doctor_summary
}

# update --ai: an agent plans the update (what to which version, what to hold back)
# with the updating-the-suite skill, and applies it after the user agrees
cmd_update_ai() {
  local prompt="Plan and run an update of this rea-suite checkout. Follow .agents/skills/updating-the-suite/SKILL.md step by step; present the plan and wait for my approval before changing anything."
  ((SYSTEM)) || prompt+=" Skip system packages (--no-apt/--no-brew)."
  agents launch "$prompt"
}

rea_doctor_summary() {
  step "rea doctor (failing checks; Hopper/IDA are optional commercial engines; registrations: see agents)"
  { "$ROOT/bin/rea" doctor --format json 2>/dev/null || true; } | python3 -c '
import json, sys
seen = set()
def walk(o):
    if isinstance(o, dict):
        if o.get("ok") is False and o.get("name") not in seen and not str(o.get("name")).startswith("registration:"):
            seen.add(o.get("name"))
            print(f"  {o.get("name")}: {o.get("remediation") or o.get("detail")}")
        for v in o.values(): walk(v)
    elif isinstance(o, list):
        for v in o: walk(v)
walk(json.load(sys.stdin))
print("  (none)" if not seen else "", end="")' || warn "rea doctor failed"
}

cmd_doctor() {
  local problems=0 pkg path version
  ok() { printf '  \033[32mok\033[0m    %-18s %s\n' "$1" "$2"; }
  bad() { printf '  \033[31mFAIL\033[0m  %-18s %s\n' "$1" "$2"; problems=$((problems + 1)); }
  info() { printf '  \033[33minfo\033[0m  %-18s %s\n' "$1" "$2"; }
  local_cmd() { # name command version-cmd...
    path="$(command -v "$2" 2>/dev/null)" || { bad "$1" "missing; run $BOOTSTRAP"; return; }
    version="$("${@:3}" 2>&1 | head -1)" || true
    if [[ "$path" == "$REA_RUNTIME"/* ]]; then ok "$1" "$version"; else
      bad "$1" "$path is outside .runtime/; run $BOOTSTRAP"
    fi
  }

  step "components"
  components list | sed 's/^/  /'

  step "runtimes (.runtime/)"
  local_cmd uv uv uv --version
  local_cmd fnm fnm fnm --version
  local_cmd node node node --version
  [[ "$(node --version 2>/dev/null)" == "v$NODE_VERSION" ]] ||
    bad "node version" "want v$NODE_VERSION (.node-version); run $BOOTSTRAP"
  local_cmd java java java -version
  java -version 2>&1 | grep -qE 'version "(2[1-9]|[3-9][0-9])' || bad "java version" "need 21+"
  local_cmd dotnet dotnet dotnet --version

  step "project environments"
  if [[ -x .venv/bin/python ]] && grep -q "^home = $REA_RUNTIME/python" .venv/pyvenv.cfg; then
    local groups
    read -ra groups <<<"$(components uv-args)"
    if uv sync --check --quiet "${groups[@]}" 2>/dev/null; then ok ".venv" "in sync with uv.lock"; else
      bad ".venv" "out of sync with uv.lock; run rea-suite setup"
    fi
  else
    bad ".venv" "missing or not on .runtime/ Python; run rea-suite reinstall python"
  fi
  if npm ls rea-agents --depth=0 >/dev/null 2>&1; then
    ok "node_modules" "rea-agents $(node -p 'require("./node_modules/rea-agents/package.json").version')"
  else
    bad "node_modules" "rea-agents missing or not matching package-lock; run rea-suite setup"
  fi

  if components values playwright | grep -qx chromium; then
    if [[ -x "${REA_BROWSER_EXECUTABLE:-}" ]]; then ok "chromium" "$REA_BROWSER_EXECUTABLE"
    else bad "chromium" "missing (component browser); run rea-suite setup"; fi
  fi

  local tool
  while read -r tool; do
    [[ "$tool" != *" @"* || "${tool##* @}" == "$OS" ]] || continue
    tool="${tool%% @*}"
    if [[ -d "$UV_TOOL_DIR/$tool" ]]; then ok "uv tool" "$tool"; else
      bad "uv tool" "$tool missing; run rea-suite setup"
    fi
  done < <(sed -e 's/#.*//' -e '/^[[:space:]]*$/d' -e 's/[[:space:]]*$//' common/uv-tools.txt)

  step "tools.yml"
  rea-tools check || problems=$((problems + 1))
  rea-tools rea-pins || problems=$((problems + 1))

  step "git"
  if [[ "$(git config core.hooksPath 2>/dev/null)" == .githooks ]]; then
    ok "hooks" "gitleaks runs on commit and push"
  else
    bad "hooks" "not enabled; run rea-suite setup (git config core.hooksPath .githooks)"
  fi

  if [[ "$OS" == macos ]]; then
    step "system packages (Homebrew)"
    if ! command -v brew >/dev/null; then
      bad "brew" "missing; install Homebrew (https://brew.sh)"
    elif brewfile | HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file=- >/dev/null 2>&1; then
      ok "brew" "all packages from $BREWFILE installed"
    else
      bad "brew" "missing: $(brewfile | HOMEBREW_NO_AUTO_UPDATE=1 brew bundle check --file=- --verbose 2>&1 |
        sed -n 's/^.* \([^ ]*\) needs to be installed.*$/\1/p' | xargs); run rea-suite setup"
    fi
    if xcode-select -p >/dev/null 2>&1; then ok "xcode clt" "$(xcode-select -p) (clang, lldb, git)"
    else bad "xcode clt" "missing; run xcode-select --install"; fi
  else
    local manager pkgs missing=() absent=()
    manager="$(pkg_manager)"
    step "system packages ($manager)"
    mapfile -t pkgs < <(linux_package_names)
    while read -r pkg; do
      # on dnf and pacman a package this system does not carry at all is information, not a fault
      if [[ "$manager" != apt ]] && ! pkg_available "$pkg"; then absent+=("$pkg")
      else missing+=("$pkg"); fi
    done < <(pkg_missing "${pkgs[@]}")
    if ((${#missing[@]})); then bad "$manager" "missing: ${missing[*]}; run rea-suite setup"
    else ok "$manager" "all packages from $APT_LIST installed"; fi
    ((${#absent[@]} == 0)) || info "$manager" "not packaged for this system: ${absent[*]}"
  fi

  step "agents (rea MCP server; rea-suite agents repairs)"
  local client state command
  while IFS=$'\t' read -r client state command; do
    case "$state" in
      ok) ok "$client" "rea via bin/rea" ;;
      missing) info "$client" "rea not registered; rea-suite agents $client" ;;
      stale) bad "$client" "suite registration settings or environment need refresh; run rea-suite agents" ;;
      *) bad "$client" "rea starts $command, not bin/rea; run rea-suite agents" ;;
    esac
  done < <(agents list)

  step "shell / desktop"
  if command -v rea-suite >/dev/null && [[ "$(readlink -f "$(command -v rea-suite)")" == "$ROOT/bin/rea-suite" ]] ||
    uv run --quiet common/rea_suite/userpath.py check >/dev/null; then
    ok "PATH" "$ROOT/bin (rea-suite, rea, rea-ghidra from anywhere)"
  else
    info "PATH" "bin/ not on PATH; run rea-suite setup (or use ./activate)"
  fi
  if ! command -v direnv >/dev/null; then
    info "direnv" "not installed; use 'source ./activate' instead"
  elif [[ "$(direnv status --json 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["state"]["foundRC"]["allowed"])' 2>/dev/null)" == 0 ]]; then
    ok "direnv" ".envrc allowed"
  else
    info "direnv" ".envrc not allowed (direnv allow) or direnv hook not active"
  fi
  if [[ -e /proc/sys/fs/binfmt_misc/WSLInterop ]]; then
    local bridged
    # no bridged tool yet is no failure: grep's exit 1 would end the doctor here, silently (set -e, pipefail)
    bridged="$({ grep -l "through WSL interop" tools/bin/* 2>/dev/null || true; } | xargs -r -n1 basename | xargs)"
    if [[ -n "$bridged" ]]; then ok "wsl interop" "Windows tools: $bridged"
    else info "wsl interop" "no Windows checkout found; set REA_SUITE_WINDOWS_ROOT, then rea-tools wsl-bridge"; fi
  fi
  if [[ "$OS" == macos || -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then ok "display" "GUI tools can start"
  else info "display" "no DISPLAY/WAYLAND_DISPLAY; GUI tools (Ghidra, Cutter, ImHex) won't start"; fi

  rea_doctor_summary
  echo
  if ((problems)); then
    printf '\033[1;31m%d problem(s) found\033[0m\n' "$problems"
    return 1
  fi
  printf '\033[1;32mall checks passed\033[0m\n'
}

# --- main --------------------------------------------------------------------

SYSTEM=1
cmd="${1:-}"
(($#)) && shift
args=()
for arg in "$@"; do
  case "$arg" in
    --no-apt | --no-dnf | --no-pacman | --no-brew) SYSTEM=0 ;;
    *) args+=("$arg") ;;
  esac
done

case "$cmd" in
  setup) cmd_setup ;;
  select) components select && cmd_setup ;;
  update) if [[ " ${args[*]} " == *" --ai "* ]]; then cmd_update_ai; else cmd_update; fi ;;
  reinstall) cmd_reinstall "${args[@]}" ;;
  status) cmd_status ;;
  doctor) cmd_doctor ;;
  agents) agents register "${args[@]}" ;;
  analyze) uv run --offline --no-sync common/rea_suite/analyze.py --caller-cwd "$CALLER_CWD" "${args[@]}" ;;
  tools) rea-tools "${args[@]}" ;;
  clean) cmd_clean "${args[@]}" ;;
  lint) exec .githooks/lint.sh "${args[@]}" ;;
  -h | --help | help | "") usage ;;
  *) echo "unknown command: $cmd" >&2; usage; exit 2 ;;
esac
