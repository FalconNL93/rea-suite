#!/usr/bin/env bash
# Headless Ghidra for one binary: analyze once, then query the project (rea-ghidra --help).
# The work is common/rea_suite/rea_ghidra.py, which runs Ghidra through ghidra_headless.py:
# a time limit, a heap cap and a refused dotted project path for every run.
set -euo pipefail
# macOS: Homebrew's bash (platforms/macos/Brewfile), not the bundled 3.2
((BASH_VERSINFO[0] >= 4)) || exec /opt/homebrew/bin/bash "$0" "$@"

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export REA_SUITE_ROOT="$ROOT"
# shellcheck source=common/box.sh disable=SC1091
source "$REA_SUITE_ROOT/common/box.sh" # immutable host: on inside the distrobox
# shellcheck source=common/env.sh disable=SC1091
source "$ROOT/common/env.sh"
# this checkout's rea_suite, also when its .venv is shared with another checkout
export PYTHONPATH="$ROOT/common${PYTHONPATH:+:$PYTHONPATH}"
exec uv run --project "$ROOT" --offline --no-sync python -m rea_suite.rea_ghidra \
  --caller-cwd "$PWD" "$@"
