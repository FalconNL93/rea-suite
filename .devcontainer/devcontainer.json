{
  "name": "rea-suite",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  // Dependencies and downloaded tools live in volumes so they never clash
  // with the host's copies in the same checkout.
  "mounts": [
    "source=rea-suite-runtime,target=${containerWorkspaceFolder}/.runtime,type=volume",
    "source=rea-suite-venv,target=${containerWorkspaceFolder}/.venv,type=volume",
    "source=rea-suite-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=rea-suite-tools,target=${containerWorkspaceFolder}/tools,type=volume"
  ],
  // ptrace for frida/lldb against processes inside the container
  "runArgs": ["--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "remoteUser": "dev",
  "postCreateCommand": "sudo chown dev: .runtime .venv node_modules tools && platforms/linux/bootstrap.sh --no-apt && direnv allow .",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "mkhl.direnv",
        "redhat.vscode-yaml",
        "timonwong.shellcheck",
        "editorconfig.editorconfig"
      ]
    }
  }
}
