# Copy to .env (ignored by git) to preselect before running the bootstrap.
# direnv loads .env too; `rea-suite select` edits the components line.

# Optional components from common/components.yml, space separated:
#   build  compilers, mingw-w64, nasm, autotools, multiarch binutils/gdb, qemu-user (default)
#   angr   angr binary analysis framework (~1 GB)
#   steam  SteamCMD + Steamless
#   vm     QEMU/OVMF (Linux) or VirtualBox (Windows) for running untrusted samples
REA_SUITE_COMPONENTS="build"

# GitHub token for tools.yml lookups (avoids the 60 requests/hour anonymous limit);
# a fine-grained token without any permissions is enough.
#GITHUB_TOKEN=
