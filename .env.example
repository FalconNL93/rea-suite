# rea-suite settings. Copy to .env (ignored by git) and uncomment what you change; every
# line here shows the default. The suite reads .env everywhere (direnv, ./activate, bin/,
# the rea MCP server an agent starts). A variable set in the environment of a run wins
# over .env, so `REA_TOOLS_NO_BUILD=1 rea-suite update` works for one run.

# --- What gets installed ----------------------------------------------------------
# Optional components (common/components.yml), space separated; `rea-suite select` edits
# this line and REA_SUITE_COMPONENTS_SEEN (which components you have been offered).
#   build     compilers, Rust, mingw-w64, multiarch binutils/gdb, qemu-user; builds the
#             tools that only exist as source (default)
#   browser   Chromium for REA's browser captures and web module tracing (default)
#   mobile    scrcpy, apkeep, uber-apk-signer (default)
#   hardware  sigrok-cli for logic analyzer recordings
#   angr      angr binary analysis framework (~1 GB)
#   steam     SteamCMD + Steamless
#   vm        QEMU/OVMF (Linux), QEMU/UTM (macOS) or VirtualBox (Windows)
#REA_SUITE_COMPONENTS="build browser mobile"

# Never build from source (tools without a release for this platform, Ghidra extensions
# without a build for the installed Ghidra, macOS Ghidra natives); doctor then reports
# what is missing.
#REA_TOOLS_NO_BUILD=1

# Leave your shell startup files / Windows user PATH alone (setup adds bin/ otherwise).
#REA_SUITE_NO_PATH=1

# GitHub token for tools.yml lookups (avoids the 60 requests/hour anonymous limit);
# a fine-grained token without any permissions is enough.
#GITHUB_TOKEN=

# --- Agents -------------------------------------------------------------------------
# Agent for `rea-suite update --ai`: any command that starts an interactive session with
# the prompt appended. Default: the first of claude, codex, copilot -i, opencode --prompt,
# gemini -i that is installed; with none, the prompt is printed to hand to any agent.
#REA_SUITE_AGENT="codex -m <model>"

# --- Windows and WSL ----------------------------------------------------------------
# In WSL: the Windows checkout of rea-suite, for launchers of its Windows-only tools
# (x64dbg, dnSpy, PE-bear, ...). Default: found through rea-suite.cmd on the Windows PATH.
#REA_SUITE_WINDOWS_ROOT=/mnt/c/Users/<you>/rea-suite

# --- REA ----------------------------------------------------------------------------
# Passed to REA (CLI and MCP server); `rea doctor` explains each. A few useful ones.
# Analysis engine for every target instead of REA's choice: ghidra, kuna, hopper, ida, ...
#REA_ANALYSIS_PROVIDER=auto
# IDA Pro: path of your upstream IDA MCP registration JSON
#REA_IDA_MCP_CONFIG=
# Hopper outside its usual location
#HOPPER_LAUNCHER_PATH=
# Slow machines or very large binaries
#REA_GHIDRA_STARTUP_TIMEOUT_MS=
#REA_GHIDRA_DECOMPILE_TIMEOUT_SECONDS=
# Ghidra analyzers to skip for speed
#REA_GHIDRA_DISABLED_ANALYZERS=
#REA_LOG_LEVEL=

# Engine paths the suite computes (tools/bin, .runtime). Set one to use your own build,
# e.g. REA_KUNA_COMMAND=/opt/kuna/kuna. The others: REA_TSHARK_COMMAND, REA_RIZIN_COMMAND,
# REA_APKTOOL_COMMAND, REA_WAKARU_COMMAND, REA_ILSPY_CMD_PATH, REA_MITMDUMP_COMMAND,
# REA_ADB_PATH, REA_UNBLOB_COMMAND, REA_SIGROK_COMMAND, REA_JADX_MCP_JAR,
# REA_BROWSER_EXECUTABLE, GHIDRA_INSTALL_DIR.
#REA_KUNA_COMMAND=

# --- rea-ghidra ---------------------------------------------------------------------
# Where headless Ghidra projects live (default work/ghidra).
#REA_GHIDRA_PROJECTS=
